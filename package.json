{
  "name": "@nnilky/utils",
  "private": false,
  "version": "0.0.15",
  "author": "Ben Brady",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ben-Brady/nnily-utils.git"
  },

  "scripts": {
    "build": "tsc",
    "release": "tsc && pnpm publish --access=public"
  },

  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./index.js": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "utility"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "./dist/**/*.d.ts",
    "./dist/**/*.js.map",
    "./dist/**/*.js"
  ],
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
